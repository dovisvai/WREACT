node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Capacitor native build output.
# The ios/ and android/ project folders ARE committed — they hold signing
# config, icons, and manifest edits. Only generated build artifacts are ignored.
ios/App/Pods/
ios/App/App/public/
ios/App/output/
ios/App/build/
ios/DerivedData/
android/app/src/main/assets/public/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
*.keystore
!debug.keystore
# Firebase Android config. Not a credential in the data-access sense -- Firestore
# rules govern that -- but it carries an AIza API key that GitHub's scanner flags
# on a public repo, and an unrestricted Google API key can be used to call other
# APIs enabled on the project. Kept out of version control; place it manually or
# inject it from a CI secret.
android/app/google-services.json
# Upload/signing keys and the passwords that unlock them. Losing these means
# never being able to update the app; committing them means anyone can.
*.jks
android/keystore.properties

# Service-account and push credentials.
# The Firebase service account JSON that OneSignal asks for on Android grants
# admin access to the entire Firebase project — it is not a public config file
# like firebase-applet-config.json. Never commit it.
*-firebase-adminsdk-*.json
service-account*.json
serviceAccountKey*.json
AuthKey_*.p8
# Google Cloud names a downloaded service-account key `pc-api-<digits>-<digits>-<hex>.json`,
# which none of the patterns above match. These grant Play Developer API access:
# reading financial data and managing subscriptions. Keep them outside the repo
# entirely -- this is only a backstop for when they end up here by accident.
pc-api-*.json
*service-account*.json
*serviceaccount*.json
*.mobileprovision
