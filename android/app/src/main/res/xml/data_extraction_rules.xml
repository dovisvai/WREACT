<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave the device in a backup or a device-to-device transfer.

  MASVS-STORAGE-2. `allowBackup` is now false, so neither path runs at all and
  this file is belt-and-braces — it exists so that if backup is ever turned back
  on, the default is exclusion rather than "sweep up everything".

  What would otherwise be swept up: the WebView's localStorage, which holds the
  athlete profile and the browser-preview Pro flag, and Capacitor Preferences.
  None of it is worth restoring — the profile lives in Firestore under the
  device's anonymous uid, and a restored uid on a second device would give two
  installs the same athlete identity, which the one-best-per-athlete standings
  rule treats as one player.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
